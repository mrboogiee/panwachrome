{
  "manifest_version": 3,
  "name": "Pan(w)achrome",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Monitor Palo Alto Networks PAN-OS firewalls through the XML API: traffic, sessions, resources and counters.",
  "icons": {
    "16": "images/icon_paper_16.png",
    "32": "images/icon_paper_32.png",
    "48": "images/icon_paper_48.png",
    "128": "images/icon_paper_128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon_paper_16.png",
      "32": "images/icon_paper_32.png"
    },
    "default_title": "Pan(w)achrome"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "offscreen",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
